{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/canonical-promotion-decision.schema.json",
  "title": "Canonical Promotion Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "promotionDecisionId",
    "decisionDate",
    "decision",
    "scope",
    "reviewEvidence",
    "exclusions",
    "downstreamEligibility",
    "reviewerRecord",
    "preservation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "promotionDecisionId": { "type": "string", "minLength": 1 },
    "decisionDate": { "type": "string", "format": "date" },
    "decision": { "const": "approved_for_canonical_promotion" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "sourceEditionId", "sourceVersionIdentifier", "sourceSha256", "sourceIds", "expectedChunkCount", "includedInformationTypes"],
      "properties": {
        "scopeId": { "type": "string", "minLength": 1 },
        "sourceEditionId": { "type": "string", "minLength": 1 },
        "sourceVersionIdentifier": { "type": "string", "minLength": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "expectedChunkCount": { "type": "integer", "minimum": 1 },
        "includedInformationTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewPackagePath", "sourceQaPath", "retrievalQaPath", "blockersClosed", "independentReviewRecorded"],
      "properties": {
        "reviewPackagePath": { "type": "string", "minLength": 1 },
        "sourceQaPath": { "type": "string", "minLength": 1 },
        "retrievalQaPath": { "type": "string", "minLength": 1 },
        "blockersClosed": { "const": true },
        "independentReviewRecorded": { "const": true },
        "notes": { "type": "string" }
      }
    },
    "exclusions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "downstreamEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learnerFacingAllowed", "appReadyAllowed", "ragReadyAllowed", "copilotExportEligible", "reason"],
      "properties": {
        "learnerFacingAllowed": { "const": false },
        "appReadyAllowed": { "const": false },
        "ragReadyAllowed": { "const": false },
        "copilotExportEligible": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "reviewerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityRecorded", "note"],
      "properties": {
        "identityRecorded": { "type": "boolean" },
        "identity": { "type": ["string", "null"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTextChanged", "chunkContentChanged", "reviewHistoryPreserved", "note"],
      "properties": {
        "sourceTextChanged": { "const": false },
        "chunkContentChanged": { "const": false },
        "reviewHistoryPreserved": { "const": true },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
